# Copy this file to .env in the server/ folder and fill in real values.
# Never commit the actual .env file.

# --- Core ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://calendarflyapp.com

# --- Admin auth ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SECRET=
SESSION_SECRET=
JWT_SECRET=

# --- AWS / DynamoDB ---
AWS_REGION=us-east-2
# AWS credentials are auto-loaded from the environment / IAM role —
# do not hardcode AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here in production.
RSVP_TABLE=
DYNAMO_EVENTS_TABLE=
DYNAMO_PANCHANG_TABLE=

# --- Cross-account chatbot Lambda (separate AWS account) ---
LAMBDA_AWS_ACCESS_KEY_ID=
LAMBDA_AWS_SECRET_ACCESS_KEY=
LAMDA_AWS_REGION=us-east-1

# --- Multi-tenant ---
DEFAULT_ORG_ID=

# --- AI chatbot ---
ANTHROPIC_API_KEY=

# --- WhatsApp Business API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GROUP_ID=
RECIPIENT_NUMBERS=
TEST_MODE=true
TEST_RECIPIENT_NUMBER=

# --- Facebook / Instagram broadcast ---
FB_PAGE_TOKEN=
FB_PAGE_ID=
IG_ACCOUNT_ID=

# --- Third-party APIs ---
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
PIXABAY_API_KEY=
REMOVE_BG_API_KEY=
