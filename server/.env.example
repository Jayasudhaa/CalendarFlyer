# Facebook Login (Pages) — from your existing Facebook app's Settings > Basic
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://calendarflyapp.com/auth/facebook/callback

# Instagram Business Login — a SEPARATE product/credentials in the same app,
# under Products > Instagram > Business Login (not the same as the values above)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://calendarflyapp.com/auth/instagram/callback

SESSION_SECRET=replace_with_a_long_random_string
